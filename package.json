{
  "name": "yolo11-visualizer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "YOLO11 real-weight activation visualizer (React + Three.js + onnxruntime-web)",
  "scripts": {
    "postinstall": "node tools/sync-ort.mjs",
    "sync:ort": "node tools/sync-ort.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "export:onnx": ".venv312\\Scripts\\python.exe tools\\export_onnx.py --imgsz 320",
    "verify:onnx": ".venv312\\Scripts\\python.exe tools\\verify_onnx.py",
    "export:graph": ".venv312\\Scripts\\python.exe tools\\export_graph.py",
    "probe": "node tools/probe.mjs http://localhost:5173/ shots",
    "probe:layers": "node tools/layers.mjs http://localhost:5173/ shots",
    "probe:structure": "node tools/probe-structure.mjs http://localhost:5173/ shots"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.13.0",
    "vite": "^8.3.4"
  }
}

# ============================================================================
#  YOLO11 特征激活可视化工作坊 —— Git 忽略规则
#
#  原则：
#    1. 依赖 / 虚拟环境 / 构建产物 / 运行截图 一律不入库 —— 它们都能用一条命令重新生成；
#    2. 源代码、配置、模型与示例素材 必须入库 —— 保证别人 clone 之后
#       只需要 `npm install` + `npm run dev` 就能跑起来。
# ============================================================================

# ---------------------------------------------------------------------------
# Node / 前端依赖与构建产物
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# npm / yarn / pnpm 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 由 npm postinstall（tools/sync-ort.mjs）从 node_modules 复制生成，约 82 MB。
# 不要入库：别人 npm install 时会自动重新生成。
public/ort/

# ---------------------------------------------------------------------------
# Python 虚拟环境与缓存
# ---------------------------------------------------------------------------
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
*.spec

# ---------------------------------------------------------------------------
# 第三方源码与权重
# ---------------------------------------------------------------------------
# ultralytics 上游仓库（943 个文件）是外部依赖，不随本项目入库。
# 但保留 yolo11n.pt（5.4 MB），这样别人 clone 之后仍能按 README 重新导出 ONNX。
ultralytics-main/*
!ultralytics-main/ultralytics/
ultralytics-main/ultralytics/*
!ultralytics-main/ultralytics/yolo11n.pt

# 如果你连权重也不想传（模型已经以 ONNX 形式存在 public/models/ 里），
# 把上面 4 行换成下面这 1 行即可：
# ultralytics-main/

# ultralytics 训练 / 导出时产生的输出目录
runs/

# ---------------------------------------------------------------------------
# 运行与调试产物
# ---------------------------------------------------------------------------
# tools/probe.mjs、tools/layers.mjs 生成的截图，以及无头 Edge 的临时 profile
shots/
*.err.txt

# ---------------------------------------------------------------------------
# 环境变量与密钥
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# 编辑器 / 操作系统
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo